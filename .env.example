FB_PAGE_ID=COLE_AQUI_O_ID
FB_PAGE_TOKEN=COLE_AQUI_O_ACCESS_TOKEN
FB_POSTS_DIA=8

# ===== AMAZON =====
AMAZON_TAG=suatag-20

# ===== KABUM! (programa de afiliados pela Awin) =====
# Seu ID de publisher na Awin (número no canto da tela da Awin, ou o 'awinaffid' de um link gerado)
