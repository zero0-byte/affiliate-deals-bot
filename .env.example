# ===== O QUE BUSCAR =====
PALAVRAS_CHAVE=mouse gamer,teclado mecânico,headset gamer,ssd nvme,placa de vídeo,memória ram ddr4,monitor gamer,cadeira gamer,controle ps5,processador ryzen,fonte atx,water cooler,mousepad gamer,webcam full hd,roteador wifi 6
DESCONTO_MINIMO=20
DESCONTO_MAXIMO=60
PRECO_MAXIMO=0
OFERTAS_POR_BUSCA=5
# Quantas palavras-chave por rodada (antes era 1) e a ordem da busca na Shopee, alternada a cada rodada:
# 2 = mais vendidos, 5 = maior comissão, 1 = relevância
PALAVRAS_POR_BUSCA=3
SHOPEE_ORDENS=2,5

# ===== AGENDA =====
INTERVALO_BUSCA_MIN=60
INTERVALO_POST_MIN=20
HORA_INICIO=8
HORA_FIM=22
FUSO=America/Sao_Paulo

# ===== ARTES / VIDEO / WHATSAPP =====
CRIATIVOS=1
VIDEO_HORA=20
WHATS_HORARIOS=9,12,18,21

# ===== CANAL DO WHATSAPP =====
WHATS_CANAL=https://whatsapp.com/channel/SEU_CANAL
WHATS_ARTE=link na bio

# ===== FACEBOOK: SO AS MELHORES =====
FB_DESCONTO_MINIMO=30
FB_HORARIOS=

# ===== INSTAGRAM (usa a mesma Página e o mesmo token do Facebook) =====
# 1 = o robô posta sozinho no Instagram. Antes, siga o GUIA-INSTAGRAM.md
INSTA=0
# Deixe vazio: o robô descobre sozinho pela Página. Só preencha se ele pedir.
IG_USER_ID=
# Deixe vazio para usar o FB_PAGE_TOKEN (que precisa das permissões do Instagram)
IG_TOKEN=
IG_HORARIOS=10,13,16,19,21
IG_DESCONTO_MINIMO=30
IG_STORIES=1
IG_REELS=1
IG_HASHTAGS=#pcgamer #setupgamer #promoção #ofertas #hardware #achadinhos #tecnologia

# ===== ALERTA DE OFERTA FORTE =====
# Te avisa na hora (com o kit do WhatsApp) e a oferta fura a fila do Telegram.
# Vira alerta com ALERTA_DESCONTO% OFF ou mais, ou quando o preço fica ALERTA_QUEDA% abaixo do menor já visto.
ALERTA_DESCONTO=45
ALERTA_QUEDA=15
ALERTA_MAX_DIA=4

# ===== VOZ DOS VIDEOS (opcional: sem estas linhas, usa a voz do Antonio, gratis) =====
# edge = gratis (vozes neurais da Microsoft) | elevenlabs = pago, a mais natural | nenhum = so a batida
VOZ_MOTOR=edge
# Escute as opcoes com o ouvir-vozes.bat e cole aqui a que gostou
VOZ=pt-BR-AntonioNeural
# Velocidade em % (0 = normal, 8 = um pouco mais rapida, bom pro TikTok)
VOZ_VELOCIDADE=8
VOZ_TOM=0
# Volume da batida por baixo da voz, em %
VOZ_MUSICA=30
# So se usar ElevenLabs:
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ_ID=

# ===== TIKTOK (opcional: o video diario vai para os rascunhos do app) =====
# Siga o GUIA-TIKTOK.md. Depois de conectar com o conectar-tiktok.bat, coloque TIKTOK=1
TIKTOK=0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Formato do video do TikTok: alternar (rodizio entre todos, padrao), um fixo (adivinha, conversa, pov,
# nao_compre, duelo, comparacao), uma lista (ex.: adivinha,pov,duelo) ou achados
TIKTOK_FORMATO=alternar
# Horarios dos videos do TikTok (ate 5 por dia). Vazio = so na VIDEO_HORA. Ex.: 12,18,21
TIKTOK_HORARIOS=

# ===== TEXTO =====
RODAPE=
